<mujoco model="flat_floor">
    <!-- 视觉与官方 Lite3_description/lite3_mjcf/mjcf/Lite3.xml 一致：checker 纹理 + 单向光。
         唯一偏差：官方平面半边长 10 m（20x20 总范围），而二轴 12 段工况实测最远到 +8.5 m，
         会走出边界，这里放大到半边长 20 m（40x40），纹理与光照参数不变。 -->
    <asset>
        <texture type="2d" name="checker" builtin="checker"
                 rgb1="0.2 0.3 0.4" rgb2="0.9 0.9 0.9" width="500" height="500"/>
        <material name="checker_mat" texture="checker" specular="1" shininess="1" texrepeat="15 15"/>
    </asset>
    <worldbody>
        <light directional="true" pos="-0.5 0.5 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="20 20 0.1" pos="0 0 0" material="checker_mat"/>
    </worldbody>
</mujoco>
