<mujoco model="flat_floor">
    <!-- 场景外观：浅蓝渐变天空、低反光灰色棋盘地面，突出机器人和四色足端轨迹。
         plane 的 size 前两项为显示半边长：100 100 对应 200×200 m。
         碰撞平面本身无限延伸，扩大显示范围不改变地面高度和接触参数。 -->
    <visual>
        <headlight ambient="0.35 0.35 0.35" diffuse="0.65 0.65 0.65" specular="0.1 0.1 0.1"/>
        <map zfar="500"/>
    </visual>
    <asset>
        <texture type="skybox" builtin="gradient"
                 rgb1="0.48 0.65 0.82" rgb2="0.88 0.93 0.98" width="512" height="3072"/>
        <texture type="2d" name="checker" builtin="checker"
                 rgb1="0.38 0.42 0.46" rgb2="0.52 0.56 0.60" width="512" height="512"/>
        <!-- 纹理按米重复，放大地面时保持棋盘格尺度，便于观察移动距离。 -->
        <material name="checker_mat" texture="checker" texuniform="true" texrepeat="1 1"
                  specular="0.1" shininess="0.15" reflectance="0"/>
    </asset>
    <worldbody>
        <light directional="true" pos="-0.5 0.5 3" dir="0 0 -1"/>
        <geom name="floor" type="plane" size="100 100 0.1" pos="0 0 0" material="checker_mat"/>
    </worldbody>
</mujoco>
